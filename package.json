{
  "name": "opdf",
  "version": "0.1.0",
  "private": true,
  "description": "OPDF PDF workspace with web/server and desktop runtimes",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @opdf/core && npm run build -w @opdf/web && npm run build -w @opdf/desktop && npm run build -w @opdf/editor",
    "typecheck": "npm run build -w @opdf/core && npm run typecheck -w @opdf/web && npm run typecheck -w @opdf/desktop && npm run typecheck -w @opdf/editor",
    "lint": "npm run typecheck",
    "check:english-ui": "node scripts/check-english-ui.mjs",
    "web-dev": "npm run dev -w @opdf/web",
    "editor-dev": "npm run dev -w @opdf/editor",
    "editor-build": "npm run build -w @opdf/editor",
    "desktop-dev": "npm run dev -w @opdf/desktop",
    "desktop-build": "npm run build -w @opdf/desktop",
    "desktop-package": "npm run package -w @opdf/desktop",
    "smoke:ai-phase1": "powershell -ExecutionPolicy Bypass -File scripts/smoke/run-ai-phase1.ps1",
    "share": "node scripts/share-tunnels.mjs",
    "perf:pdf": "node scripts/perf/generate-large-pdf.mjs",
    "server-build": "npm run build -w @opdf/core && npm run build -w @opdf/web",
    "server-start": "node server/opdf-server.mjs",
    "server-smoke": "node server/opdf-server.smoke.mjs",
    "opdf": "node scripts/opdf-cli.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "audit:prod": "node scripts/opdf-cli.mjs audit smoke",
    "server-reliability": "node server/opdf-server.reliability.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3"
  },
  "bin": {
    "opdf": "./scripts/opdf-cli.mjs"
  }
}
