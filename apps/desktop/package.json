{
  "name": "@opdf/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:preload && cross-env OPDF_DEV_SERVER=http://localhost:5174 OPDF_PROJECT_PATH=C:/mymy/Opdf electron .",
    "build": "npm run build:main && npm run build:preload",
    "build:main": "npx -p typescript tsc -p tsconfig.main.json",
    "build:preload": "npx -p typescript tsc -p tsconfig.preload.json",
    "typecheck": "npx -p typescript tsc -p tsconfig.main.json --noEmit && npx -p typescript tsc -p tsconfig.preload.json --noEmit",
    "lint": "npm run typecheck",
    "prepare:webdist": "node scripts/prepare-webdist.mjs",
    "package": "npm run prepare:webdist && electron-builder"
  },
  "dependencies": {
    "@opdf/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "cross-env": "^7.0.3",
    "electron": "32.2.2",
    "electron-builder": "^24.13.3",
    "typescript": "^5.8.3"
  },
  "build": {
    "asarUnpack": [
      "tools/**"
    ],
    "appId": "com.opdf.desktop",
    "files": [
      "dist/**/*",
      "web/**/*",
      "tools/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
