{
  "name": "opdf",
  "version": "0.1.0",
  "private": true,
  "description": "OPDF PDF workspace with web/server and desktop runtimes",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@opdf/core && npm run build --workspace=@opdf/web && npm run build --workspace=@opdf/desktop && npm run build --workspace=@opdf/editor",
    "typecheck": "npm run build --workspace=@opdf/core && npm run typecheck --workspace=@opdf/web && npm run typecheck --workspace=@opdf/desktop && npm run typecheck --workspace=@opdf/editor",
    "lint": "npm run typecheck",
    "check:english-ui": "node scripts/check-english-ui.mjs",
    "web-dev": "npm run dev --workspace=@opdf/web",
    "editor-dev": "npm run dev --workspace=@opdf/editor",
    "editor-build": "npm run build --workspace=@opdf/editor",
    "desktop-dev": "npm run dev --workspace=@opdf/desktop",
    "desktop-build": "npm run build --workspace=@opdf/desktop",
    "desktop-package": "npm run package --workspace=@opdf/desktop",
    "smoke:ai-phase1": "powershell -ExecutionPolicy Bypass -File scripts/smoke/run-ai-phase1.ps1",
    "share": "node scripts/share-tunnels.mjs",
    "perf:pdf": "node scripts/perf/generate-large-pdf.mjs",
    "server-build": "npm run build --workspace=@opdf/core && npm run build --workspace=@opdf/web",
    "server-start": "node server/opdf-server.mjs",
    "server-smoke": "node server/opdf-server.smoke.mjs",
    "server-auth-smoke": "node server/opdf-server.auth.smoke.mjs",
    "server-s3-smoke": "node server/opdf-s3.smoke.mjs",
    "server-production-smoke": "node server/opdf-production.smoke.mjs",
    "opdf": "node scripts/opdf-cli.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "audit:prod": "node scripts/opdf-cli.mjs audit smoke",
    "server-reliability": "node server/opdf-server.reliability.mjs",
    "backup-smoke": "node server/opdf-backup.smoke.mjs",
    "backup:create": "node scripts/opdf-backup.mjs create",
    "backup:verify": "node scripts/opdf-backup.mjs verify",
    "backup:restore": "node scripts/opdf-backup.mjs restore",
    "check:file-size": "node scripts/check-file-size.mjs",
    "perf:real-world": "node scripts/perf/real-world-pdf-smoke.mjs",
    "storage:prune": "node scripts/opdf-storage-prune.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3"
  },
  "bin": {
    "opdf": "./scripts/opdf-cli.mjs"
  }
}
