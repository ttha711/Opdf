# Dify AI Assistant Configuration Template
# Copy this file to '.env' in this directory and populate your own credentials.

# The base URL of your self-hosted or cloud Dify API
VITE_DIFY_API_URL=https://your-dify-domain/v1

# Your specific Dify App Chat Client API Key (e.g. app-xxxxxxxxxxxxxxxx)
VITE_DIFY_API_KEY=your_dify_api_key_here
