{
  "name": "tpdf",
  "version": "0.1.0",
  "private": true,
  "description": "TPDF PDF workspace with web/server and desktop runtimes",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@tpdf/core && npm run build --workspace=@tpdf/web && npm run build --workspace=@tpdf/desktop && npm run build --workspace=@tpdf/editor",
    "typecheck": "npm run build --workspace=@tpdf/core && npm run typecheck --workspace=@tpdf/web && npm run typecheck --workspace=@tpdf/desktop && npm run typecheck --workspace=@tpdf/editor",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:english-ui": "node scripts/check-english-ui.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "web-dev": "npm run dev --workspace=@tpdf/web",
    "editor-dev": "npm run dev --workspace=@tpdf/editor",
    "editor-build": "npm run build --workspace=@tpdf/editor",
    "desktop-dev": "npm run dev --workspace=@tpdf/desktop",
    "desktop-build": "npm run build --workspace=@tpdf/desktop",
    "desktop-package": "npm run package --workspace=@tpdf/desktop",
    "smoke:ai-phase1": "powershell -ExecutionPolicy Bypass -File scripts/smoke/run-ai-phase1.ps1",
    "share": "node scripts/share-tunnels.mjs",
    "perf:pdf": "node scripts/perf/generate-large-pdf.mjs",
    "server-build": "npm run build --workspace=@tpdf/core && npm run build --workspace=@tpdf/web",
    "server-start": "node server/tpdf-server.mjs",
    "server-smoke": "node server/tpdf-server.smoke.mjs",
    "server-auth-smoke": "node server/tpdf-server.auth.smoke.mjs",
    "server-s3-smoke": "node server/tpdf-s3.smoke.mjs",
    "server-production-smoke": "node server/tpdf-production.smoke.mjs",
    "tpdf": "node scripts/tpdf-cli.mjs",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "audit:prod": "node scripts/tpdf-cli.mjs audit smoke",
    "audit:headers": "node scripts/verify-production-headers.mjs",
    "server-reliability": "node server/tpdf-server.reliability.mjs",
    "backup-smoke": "node server/tpdf-backup.smoke.mjs",
    "backup:create": "node scripts/tpdf-backup.mjs create",
    "backup:verify": "node scripts/tpdf-backup.mjs verify",
    "backup:restore": "node scripts/tpdf-backup.mjs restore",
    "check:file-size": "node scripts/check-file-size.mjs",
    "perf:real-world": "node scripts/perf/real-world-pdf-smoke.mjs",
    "storage:prune": "node scripts/tpdf-storage-prune.mjs",
    "test:cad:fetch": "node scripts/fixtures/fetch-real-cad-pdfs.mjs",
    "test:cad": "playwright test -c playwright.server.config.ts tests/server-e2e/real-cad-corpus.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.60.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.2"
  },
  "bin": {
    "tpdf": "./scripts/tpdf-cli.mjs"
  }
}
