{
  "name": "@opdf/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:preload && cross-env OPDF_DEV_SERVER=http://localhost:5174 OPDF_PROJECT_PATH=C:/mymy/Opdf electron .",
    "build": "npm run build:main && npm run build:preload",
    "build:main": "npx -p typescript tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/preload.cjs",
    "typecheck": "npx -p typescript tsc -p tsconfig.main.json --noEmit && npx -p typescript tsc -p tsconfig.preload.json --noEmit",
    "lint": "npm run typecheck",
    "prepare:webdist": "node scripts/prepare-webdist.mjs",
    "package": "npm run prepare:webdist && electron-builder"
  },
  "dependencies": {
    "@opdf/core": "0.1.0",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "cross-env": "^10.1.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "@types/node-forge": "^1.3.14"
  },
  "build": {
    "asarUnpack": [
      "tools/**"
    ],
    "appId": "com.opdf.desktop",
    "files": [
      "dist/**/*",
      "web/**/*",
      "tools/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
