{
  "name": "@opdf/editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env PORT=5175 tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scratch/e2e_test.js",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tsc --noEmit",
      "npx tsc --noEmit"
    ],
    "*.{js,cjs,mjs}": [
      "node --check"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-character-count": "^3.31.4",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-font-family": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-table-cell": "^3.31.4",
    "@tiptap/extension-table-header": "^3.31.4",
    "@tiptap/extension-table-row": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-typography": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "jsdiff": "^1.1.1",
    "jspdf": "^4.2.1",
    "juice": "^12.2.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "officeparser": "^8.1.0",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.2",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.2"
  }
}
